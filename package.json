{
  "name": "numenor-backend",
  "version": "1.0.0",
  "description": "Numenor backend API (Node.js, Express, MySQL)",
  "main": "dist/server.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "seed:executive": "tsx src/scripts/seedExecutive.ts",
    "test": "tsx --test test/api.test.ts",
    "db:generate": "drizzle-kit generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
