# Edge proxy: terminates HTTPS (certificates from Let's Encrypt, renewed automatically),
# sends /api/* to the backend and everything else to the static client.
{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:5001
	}

	handle {
		reverse_proxy web:80
	}
}

# www.<domain> → <domain>. Needs the www record pointing here too (a CNAME to the apex is fine);
# without it Caddy just can't get a certificate for www, the main domain is unaffected.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
