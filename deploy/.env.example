# Production settings for deploy/docker-compose.yml. Copy to deploy/.env and fill in.
# Generate secrets with: openssl rand -hex 32

# Domain pointing (DNS A record) at this server. Client and API share it: the API is under /api.
DOMAIN=nsportal.app

# MySQL runs in its own container and is not exposed outside the server.
# Use hex passwords (openssl rand -hex 24) — DB_PASSWORD is embedded in the connection URI.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# How long a login session lasts before the user has to sign in again.
SESSION_TTL_HOURS=12

SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=damon@numenorsystems.com
SMTP_PASSWORD=
SMTP_FROM="Numenor Systems <damon@numenorsystems.com>"

# Never change this after data has been written — encrypted fields become unreadable.
FIELD_ENCRYPTION_PASSPHRASE=
