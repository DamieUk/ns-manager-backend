# S3-compatible object storage for uploaded files (contracts, BOM files, progress-report
# photos). Works with any S3-compatible provider — Cloudflare R2, AWS S3, Backblaze B2,
# DigitalOcean Spaces, etc. For R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com,
# S3_REGION=auto.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
