PORT=5001
NODE_ENV=development
# MySQL (or MariaDB) connection. Percent-encode special characters in the password.
DATABASE_URL=mysql://root@127.0.0.1:3306/numenor
CLIENT_ORIGIN=http://localhost:5173

# How long a login session lasts before the user has to sign in again.
SESSION_TTL_HOURS=12

SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=damon@numenorsystems.com
SMTP_PASSWORD=
SMTP_FROM=Numenor Systems <damon@numenorsystems.com>

FIELD_ENCRYPTION_PASSPHRASE=

# Directory for uploaded files (contracts, BOM files, progress-report photos).
# Defaults to ./uploads in the project root. In production (deploy/docker-compose.yml)
# it is a persistent Docker volume mounted at /app/uploads.
# UPLOAD_DIR=
